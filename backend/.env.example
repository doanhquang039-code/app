# Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=your-password
DB_DATABASE=ExpenseTrackerDB

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRATION=7d

# Social Login / OAuth
FRONTEND_URL=http://localhost:3001
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
OAUTH_STATE_SECRET=change-this-oauth-state-secret
MOBILE_OAUTH_CALLBACK_URL=expensetracker://auth/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
ZALO_APP_ID=your-zalo-app-id
ZALO_APP_SECRET=your-zalo-app-secret
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Email Configuration
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# OpenAI Configuration (Optional - for AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Plaid Configuration (Optional - for bank integration)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# AWS Configuration (Optional - for cloud storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Firebase Configuration (Optional - for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Stripe Configuration (Optional - for payments)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Twilio Configuration (Optional - for SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# SendGrid Configuration (Optional - for email)
SENDGRID_API_KEY=your-sendgrid-api-key

# Redis Configuration (Optional - for caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch Configuration (Optional - for search)
ELASTICSEARCH_NODE=http://localhost:9200
