# ☁️ CLOUD SERVICES CONFIGURATION

# ========================================
# AWS (Amazon Web Services)
# ========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=expense-tracker-bucket
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/expense-tracker-queue

# ========================================
# Firebase
# ========================================
FIREBASE_PROJECT_ID=expense-tracker-12345
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@expense-tracker-12345.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://expense-tracker-12345.firebaseio.com

# ========================================
# Cloudinary (Image CDN)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# SendGrid (Email Service)
# ========================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@expensetracker.com
SENDGRID_FROM_NAME=Expense Tracker

# ========================================
# Twilio (SMS & WhatsApp)
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# Stripe (Payment Processing)
# ========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=usd

# ========================================
# Redis (Required for Bull Queue & Caching)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# Elasticsearch (Optional)
# ========================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ========================================
# Database
# ========================================
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=your_password
DB_DATABASE=ExpenseTrackerDB

# ========================================
# JWT
# ========================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ========================================
# App Configuration
# ========================================
NODE_ENV=production
PORT=3000
APP_URL=https://expensetracker.com
FRONTEND_URL=https://app.expensetracker.com

# ========================================
# Feature Flags
# ========================================
ENABLE_AWS_S3=true
ENABLE_AWS_LAMBDA=true
ENABLE_AWS_SQS=true
ENABLE_FIREBASE=true
ENABLE_CLOUDINARY=true
ENABLE_SENDGRID=true
ENABLE_TWILIO=true
ENABLE_STRIPE=true
ENABLE_REDIS=true
ENABLE_ELASTICSEARCH=false

# ========================================
# Monitoring & Logging
# ========================================
LOG_LEVEL=info
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
